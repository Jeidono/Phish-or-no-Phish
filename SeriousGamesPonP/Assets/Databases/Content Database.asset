MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9184aae795d506d4a916abd52411a6f1, type: 3}
  m_Name: Content Database
  m_EditorClassIdentifier: 
  audioItems:
  - clip: {fileID: 0}
    description: 
    duration: 0
    isPhishing: 0
  - clip: {fileID: 0}
